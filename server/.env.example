NODE_ENV=development
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/cozy_crumbs
# Use only for local development when MongoDB is not available.
ALLOW_IN_MEMORY_DB=true
AUTO_SEED=true
# Generate a unique value of at least 32 characters for every environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@cozycrumbs.local
ADMIN_PASSWORD=ChangeThisBeforeDeploying123!
